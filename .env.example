# ---------------------------------------------------------------------------
# Arabian TIGRIZ website — environment variables
# Copy to .env.local and fill in VERIFIED values only. Empty = hidden on site.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Enables canonical/Open Graph URLs,
# sitemap.xml, the robots sitemap entry and structured data URL.
NEXT_PUBLIC_SITE_URL=

# --- Public contact details (shown on the site only when set) --------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp number in international format, digits only or with +, e.g. 9715XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_LOCATION=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# --- Enquiry delivery (server only — never prefix with NEXT_PUBLIC_) -------
# Configure at least one channel, otherwise /api/enquiry returns 503 and the
# form tells visitors online enquiries are unavailable (no fake success).

# Option A: any webhook / CRM / automation endpoint receiving JSON
ENQUIRY_WEBHOOK_URL=

# Option B: email via Resend (https://resend.com)
RESEND_API_KEY=
# Comma-separated recipients
ENQUIRY_TO_EMAIL=
# Must be a sender on a domain verified in Resend
ENQUIRY_FROM_EMAIL=
